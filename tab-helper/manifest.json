{
  "manifest_version": 3,
  "name": "Swich Tab Helper",
  "version": "1.4.0",
  "description": "Swich camera and touch-wire controls for webpage video, audio, scrolling, and local files in the Swich player.",
  "minimum_chrome_version": "106",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://marwanahmed2023-creator.github.io/swich/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ]
}
